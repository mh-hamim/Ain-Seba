# ============================================
# AinSeba - Environment Configuration
# ============================================

# Paths (defaults work for most setups)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Chunking Configuration
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI (REQUIRED from Phase 2 onwards)
OPENAI_API_KEY=sk-your-key-here

# ChromaDB Configuration (Phase 2)
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=ainseba_laws

# Retrieval Configuration (Phase 2)
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true            # false on memory-capped hosts (Render free tier)

# LLM Configuration (Phase 3)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
CONVERSATION_MEMORY_K=5

# Bilingual Support (Phase 4)
TRANSLATION_MODEL=gpt-4o-mini
DEFAULT_RESPONSE_LANGUAGE=auto

# FastAPI Backend (Phase 5)
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=30
API_RATE_WINDOW=60
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
